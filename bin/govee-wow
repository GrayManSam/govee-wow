                 "green": True, "lift": 1.2, "lift_max": 0.85, "vivid": 0.9},
    # lift raises the calm base looks a little but never above lift_max of the cap, so cues
    # keep headroom instead of clipping into white (the old 1.45 lift pinned everything at 100%)
}
# Brightness cap per style (% of the lights' maximum, = the Govee dimmer). Nothing the show
# sends - base looks, flashes, cues, the ceiling stream, lamp segments - can go above it:
# colors are 0-1 *of the cap*. Daytime is the brightest (user: 100% hurt, 60% max).
MAX_LEVEL = {"daylight": 60, "party": 55, "standard": 50, "comfort": 45, "afterdark": 2}


def style_name(conf):
    """The style in effect now: the time-of-day schedule if there is one, else `night_style`
    during night hours, else `style`."""
    h = time.localtime().tm_hour
    if conf.get("schedule"):
        for a, b, name in conf["schedule"]:
            if name in STYLES and ((h >= a or h < b) if a > b else a <= h < b):
                return name
        d = conf.get("schedule_default")
        return d if d in STYLES else "standard"
    ns = conf.get("night_style")
    if ns in STYLES:
        h = time.localtime().tm_hour
        a, b = conf["night_from"], conf["night_to"]
        if (h >= a or h < b) if a > b else a <= h < b:
            return ns
    return conf.get("style") if conf.get("style") in STYLES else "comfort"


def level_cap(conf, name=None):
    """Brightness cap % for a style (default: the one in effect now). After dark uses its own
    tiny level (1-10); the others their "max_level" entry, never above the master "level"."""
    name = name or style_name(conf)
    if STYLES[name].get("warm"):
        return max(1, min(10, int(conf.get("afterdark_level", MAX_LEVEL["afterdark"]))))
    cap = (conf.get("max_level") or {}).get(name, MAX_LEVEL.get(name, 50))
    return max(1, min(100, int(min(conf["level"], cap))))


def warm(c):
    """Night filter: any color -> red / deep orange / amber of the same strength, zero blue."""
    v = max(c)
    if v <= 0:
        return (0.0, 0.0, 0.0)
    t = min(1.0, (c[1] + 0.5 * c[2]) / (c[0] + c[1] + c[2]) * 2)
    return (v, 0.42 * t * v, 0.0)

