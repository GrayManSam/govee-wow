# Styles. "slew" = the most a light's brightness may change per second (full range = 1.0);
# it is a hard limit applied last, so no effect can strobe faster than the style allows.
# "vivid" (0-1) = how much of the white / gray part of every color is removed before sending
# (1 = fully saturated LED colors). Brightness caps live in config "max_level" (MAX_LEVEL).
STYLES = {
    "comfort":  {"flash": False, "max_flashes": 1, "speed": 0.55, "slew": 0.9, "fx": 0.5,
